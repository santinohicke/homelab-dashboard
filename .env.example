# ==============================================================================
# HOMELAB DASHBOARD - FRONTEND CONFIGURATION TEMPLATE
# ==============================================================================
# Variables con prefijo VITE_ están disponibles en tiempo de compilación.
# ==============================================================================

# Nombre mostrado en la cabecera
VITE_SERVER_NAME="Lenovo ThinkCentre M93p Tiny"

# Dominio base o IP del Reverse Proxy
VITE_API_BASE_URL="https://lab.homelab.local"

# Frecuencia de polling de telemetría (milisegundos)
VITE_POLL_INTERVAL_MS=5000

# Tarifa eléctrica por defecto en Pesos Argentinos ($ ARS / kWh)
VITE_DEFAULT_TARIFF_ARS=135
